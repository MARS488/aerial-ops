# Example only. Do not put a real secret in this file.
# Hosted mode is off unless SANDBOX_HOSTED=1.
# Default ingress is loopback and refuses every bind except 127.0.0.1.
# There is no public URL. The hosted candidate is FAIL.
#
# Trusted-proxy is a private rehearsal, not an approval to deploy.
# It still requires SANDBOX_HOSTED=1, an https origin with no path,
# and a proxy secret of at least 24 characters supplied outside this file.
# SANDBOX_INGRESS=loopback
# SANDBOX_PUBLIC_ORIGIN=https://fictional-preview.test

SANDBOX_HOSTED=0
SANDBOX_BIND=127.0.0.1
# Optional rehearsal limit for guest writes per minute.
# SANDBOX_GUEST_WRITE_LIMIT=30
